---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { getCollection } from 'astro:content';
import { UI, thoughtPath } from '../../i18n';
const t = UI.en;
const list = (await getCollection('thoughts', (x) => !x.data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base lang="en" title="Daily thought, ai storians" description={t.thoughtsSub} path="/daily-thought" alternates={{ en: '/daily-thought' }}>
  <PageHead kicker={t.nav.writing} title={t.thoughtsTitle} lede={t.thoughtsSub} />
  <section class="section">
    <div class="wrap">
      <ol class="index">
        {list.map((x) => (
          <li><a href={thoughtPath(x.id.split('/').pop()!)}>
            <span class="n"></span>
            <span class="t">{x.data.title}</span>
            <span class="d">{x.data.deck}</span>
            <time class="meta date" datetime={x.data.date.toISOString()}>{t.dateFmt(x.data.date)}</time>
          </a></li>
        ))}
      </ol>
    </div>
  </section>
</Base>
