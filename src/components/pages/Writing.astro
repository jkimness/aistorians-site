---
import Base from '../../layouts/Base.astro';
import PageHead from '../PageHead.astro';
import EssayList from '../EssayList.astro';
import Newsletter from '../Newsletter.astro';
import { UI, ROUTES, essayPath, thoughtPath, type Lang } from '../../i18n';
import { copy } from '../../i18n/copy';
import { essays, slugOf, type ListItem } from '../../lib/essays';
import { getCollection } from 'astro:content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = UI[lang];
const c = copy(lang);
const w = c.writing;
const fromEssays: ListItem[] = (await essays(lang)).map((e) => ({
  href: essayPath(lang, slugOf(e)), title: e.data.title, ep: e.data.ep, deck: e.data.deck, date: e.data.date,
  cover: e.data.cover, coverAlt: e.data.coverAlt, seed: slugOf(e),
}));
// Daily thoughts are English only; they sit in the same dated list on the English page.
const fromThoughts: ListItem[] = lang === 'en'
  ? (await getCollection('thoughts', (x) => !x.data.draft)).map((x) => ({
      href: thoughtPath(x.id.split('/').pop()!), title: x.data.title, deck: x.data.deck, date: x.data.date,
      label: t.thoughtsTitle, seed: x.id,
    }))
  : [];
const items = [...fromEssays, ...fromThoughts].sort((a, b) => b.date.valueOf() - a.date.valueOf() || (b.ep ?? 0) - (a.ep ?? 0));
---
<Base lang={lang} title={c.meta.writing.title} description={c.meta.writing.description} path={ROUTES.writing[lang]} alternates={{ en: ROUTES.writing.en, ko: ROUTES.writing.ko }}>
  <PageHead kicker={w.kicker} title={w.title} lede={w.lede} />
  <section class="section section--archive">
    <div class="wrap">
      <EssayList items={items} lang={lang} />
    </div>
  </section>
  <Newsletter lang={lang} />
</Base>
