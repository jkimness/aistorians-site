---
import Base from '../../layouts/Base.astro';
import PageHead from '../PageHead.astro';
import FinalCta from '../FinalCta.astro';
import { Image } from 'astro:assets';
import portrait from '../../assets/jae-portrait.jpg';
import { ROUTES, type Lang } from '../../i18n';
import { copy } from '../../i18n/copy';
import { LINKS } from '../../site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy(lang);
const a = c.about;
const find = [
  { name: lang === 'ko' ? 'ai storians, 섭스택' : 'ai storians on Substack', where: 'aistorians.substack.com', href: LINKS.substack },
  { name: lang === 'ko' ? '모건 레터' : 'Morgan Letter', where: 'jkimmorgan.substack.com', href: LINKS.morganLetter },
  { name: 'FIRE사이드챗', where: 'YouTube @firesidechathq', href: LINKS.youtube },
  { name: lang === 'ko' ? '브런치 연재' : 'Brunch (Korean)', where: 'brunch.co.kr/@jkimmorgan', href: LINKS.brunch },
  { name: 'Threads', where: '@jkimmorgan', href: LINKS.threads },
  { name: 'Instagram', where: '@jkimmorgan', href: LINKS.instagram },
];
const jsonLd = { '@context': 'https://schema.org', '@type': 'Person', name: 'Jae Kim', alternateName: '제이킴모건', url: 'https://www.aistorians.com/about', jobTitle: 'Writer and speaker', sameAs: find.map((f) => f.href) };
---
<Base lang={lang} title={c.meta.about.title} description={c.meta.about.description} path={ROUTES.about[lang]} alternates={{ en: ROUTES.about.en, ko: ROUTES.about.ko }} jsonLd={jsonLd}>
  <PageHead kicker={a.kicker} title={a.title}>
    <figure class="portrait-col portrait-photo">
      <Image src={portrait} alt={a.photoAlt} widths={[420, 640, 780]} sizes="(max-width: 960px) 90vw, 460px" loading="eager" fetchpriority="high" />
    </figure>
  </PageHead>
  <div class="wrap rows">
    <section class="row" style="align-items:start">
      <div class="row-label"><p class="kicker">{lang === 'ko' ? '제이킴모건' : 'Jae Kim'}</p></div>
      <div class="row-body prose-block">
        {a.paras.map((p, i) => <p style={i === 0 ? 'font-size:clamp(22px,2.2vw,27px);line-height:1.42' : ''}>{p}</p>)}
      </div>
    </section>
    <section class="row">
      <div class="row-label"><p class="kicker">{a.believeTitle}</p></div>
      <div class="row-body"><div class="pillars">{a.beliefs.map((b) => <div class="pillar"><h3>{b.title}</h3><p>{b.text}</p></div>)}</div></div>
    </section>
    <section class="row">
      <div class="row-label"><p class="kicker">{a.whyTitle}</p></div>
      <div class="row-body prose-block">{a.why.map((p) => <p>{p}</p>)}</div>
    </section>
    <section class="row">
      <div class="row-label"><p class="kicker">{a.findTitle}</p></div>
      <div class="row-body">
        <ul class="linklist">{find.map((f) => <li><a href={f.href} target="_blank" rel="me noopener"><span class="name">{f.name}</span><span class="where">{f.where}</span></a></li>)}</ul>
      </div>
    </section>
  </div>
  <FinalCta lang={lang} title={a.ctaTitle} text={c.speaking.finalText} button={a.cta} />
</Base>
