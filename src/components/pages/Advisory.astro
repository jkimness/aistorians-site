---
import Base from '../../layouts/Base.astro';
import PageHead from '../PageHead.astro';
import { ROUTES, type Lang } from '../../i18n';
import { copy } from '../../i18n/copy';
import { SITE } from '../../site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy(lang);
const a = c.advisory;
const mail = `mailto:${SITE.email}?subject=Advisory`;
---
<Base lang={lang} title={c.meta.advisory.title} description={c.meta.advisory.description} path={ROUTES.advisory[lang]} alternates={{ en: ROUTES.advisory.en, ko: ROUTES.advisory.ko }}>
  <PageHead kicker={a.kicker} title={a.title} lede={a.lede} />
  <div class="wrap rows">
    {a.help.length > 0 && (
      <section class="row">
        <div class="row-label"><p class="kicker">{a.helpTitle}</p></div>
        <div class="row-body talks">
          {a.help.map((h, i) => (
            <div class="talk"><span class="n">{String(i + 1).padStart(2, '0')}</span><div><h3>{h.title}</h3><p>{h.text}</p></div></div>
          ))}
        </div>
      </section>
    )}
    {a.how.length > 0 && (
      <section class="row">
        <div class="row-label"><p class="kicker">{a.howTitle}</p></div>
        <div class="row-body">
          <ol class="steps">{a.how.map((h, i) => <li><span class="n">{String(i + 1).padStart(2, '0')}</span><h3>{h.title}</h3><p>{h.text}</p></li>)}</ol>
        </div>
      </section>
    )}
    {a.who && (
      <section class="row">
        <div class="row-label"><p class="kicker">{a.whoTitle}</p></div>
        <div class="row-body prose-block"><p style="font-size:clamp(22px,2.2vw,28px);line-height:1.4">{a.who}</p>
          <p class="meta" style="margin-top:22px;text-transform:none;letter-spacing:0">{a.byline} {a.cases}</p></div>
      </section>
    )}
    <section class="row">
      <div class="row-label"><p class="kicker">{c.contact.kicker}</p></div>
      <div class="row-body"><a class="btn" href={mail}>{a.cta}</a> <span class="meta" style="margin-left:14px;text-transform:none">{SITE.email}</span></div>
    </section>
  </div>
</Base>
